# Copy to .env.local and fill in real values. Never commit .env.local.
# Local Postgres (this machine):
#   DATABASE_URL=postgres://<user>:<password>@localhost:5432/appointment_app
# Neon (deploy):
#   DATABASE_URL=postgres://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=
# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Public base URL of the deployed app, no trailing slash. Used to
# build OAuth callback URLs. On Vercel set this to the production
# URL, e.g. https://carebook-pearl.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google sign-in (Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> Web application).
# Redirect URI to register exactly:
#   https://carebook-pearl.vercel.app/api/auth/google/callback
# Leave both blank to show Google sign-in as "not configured yet".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub sign-in (GitHub -> Settings -> Developer settings -> OAuth
# Apps -> New OAuth App).
# Authorization callback URL to register exactly:
#   https://carebook-pearl.vercel.app/api/auth/github/callback
# Leave both blank to show GitHub sign-in as "not configured yet".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Microsoft sign-in, personal accounts (Microsoft Entra admin center
# -> App registrations -> New registration; account type "Accounts
# in any organizational directory and personal Microsoft accounts";
# platform Web).
# Redirect URI to register exactly:
#   https://carebook-pearl.vercel.app/api/auth/microsoft/callback
# Leave both blank to show Microsoft sign-in as "not configured yet".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
