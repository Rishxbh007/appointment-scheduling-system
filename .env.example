# Copy to .env.local and fill in real values. Never commit .env.local.
# Local Postgres (this machine):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/appointment_app
# Neon (deploy):
#   DATABASE_URL=postgres://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=
# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
