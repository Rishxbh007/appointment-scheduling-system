# Copy to .env.local and fill in real values. Never commit .env.local.
# Local Postgres (this machine):
#   DATABASE_URL=postgres://<user>:<password>@localhost:5432/appointment_app
# Neon (deploy):
#   DATABASE_URL=postgres://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=
# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Public base URL of the deployed app, no trailing slash. Used to
# build OAuth callback URLs. On Vercel set this to the production
# URL, e.g. https://carebook-pearl.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google sign-in (Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> Web application).
# Redirect URI to register exactly:
#   https://carebook-pearl.vercel.app/api/auth/google/callback
# Leave both blank to show Google sign-in as "not configured yet".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub sign-in (GitHub -> Settings -> Developer settings -> OAuth
# Apps -> New OAuth App).
# Authorization callback URL to register exactly:
#   https://carebook-pearl.vercel.app/api/auth/github/callback
# Leave both blank to show GitHub sign-in as "not configured yet".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Microsoft sign-in, personal accounts (Microsoft Entra admin center
# -> App registrations -> New registration; account type "Accounts
# in any organizational directory and personal Microsoft accounts";
# platform Web).
# Redirect URI to register exactly:
#   https://carebook-pearl.vercel.app/api/auth/microsoft/callback
# Leave both blank to show Microsoft sign-in as "not configured yet".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Razorpay payments (Day 4 Stage A). Test mode needs only email
# verification — no KYC/documents. Keys are server-only: never put
# them in NEXT_PUBLIC_ variables and never paste them in chat.
# Leave all blank to fail closed: paid bookings are blocked with a
# clear message, never fake-confirmed.
# Razorpay Dashboard -> Settings -> API Keys (test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Settings -> Webhooks. Register exactly:
#   https://carebook-pearl.vercel.app/api/payments/webhook
# and copy the webhook secret shown there.
RAZORPAY_WEBHOOK_SECRET=
# Public key id for Razorpay Checkout.js (same value as
# RAZORPAY_KEY_ID; safe to expose in the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Email notifications (Day 4 Stage C). Gmail SMTP via the clinic's
# existing Gmail account — no new account, no verified domain
# needed. SMTP_PASS is a Gmail app password, never the account
# password: Google Account -> Security -> 2-Step Verification ->
# App passwords -> generate one (16 characters) and paste it here.
# Leave SMTP_USER/SMTP_PASS blank and notifications are recorded
# as Failed with "email not configured" — never fake-sent.
# The mailer is one swappable module (lib/services/mailer.ts), so
# moving to Resend later (with a verified domain) is a one-module
# swap, not a rewrite.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Shared secret for the daily reminder cron
# (GET /api/cron/reminders). Vercel Cron and any external
# scheduler must send: Authorization: Bearer <this value>.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the cron endpoint refuses every call.
CRON_SECRET=
# Day 5 notification settings (all optional — defaults apply
# when blank):
#   REMINDER_INTERVALS_HOURS: comma-separated hours before the
#     appointment at which reminders fire (default "24").
#     Example "24,1" sends a day-before and an hour-before
#     reminder. Only whole hours 1–168 count; anything else is
#     ignored, and an empty value falls back to "24".
#   SMS_PROVIDER: "log" (default) writes SMS to the server log
#     and records a log reference — the honest no-account state,
#     since the clinic has no SMS provider account yet. Any
#     other value is not implemented and fails loudly instead
#     of fake-sending. See docs/notifications.md for adding a
#     real provider (Vonage, MSG91).
#   NOTIFICATION_MAX_ATTEMPTS: max send attempts per row
#     (default 3). NOTIFICATION_RETRY_DELAY_MINUTES: base retry
#     delay (default 30); attempt N waits N times the base.
REMINDER_INTERVALS_HOURS=24
SMS_PROVIDER=log
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MINUTES=30
# SMS via Vonage (Day 5 follow-up). Leave blank and SMS stays on
# the logged driver. To send real texts: sign up for a Vonage
# free trial (no card; about €2 credit), verify your own
# phone number (trial accounts can only text verified numbers;
# add yours under test numbers in the dashboard), copy the
# API key + secret from the dashboard, and set them here AND
# in Vercel (same names). Set VONAGE_FROM_NUMBER to an
# alphanumeric sender like CareBook, or a Vonage number.
# Then set SMS_PROVIDER=vonage.
# Trial texts carry a demo tag, and trial sends only go to
# verified numbers (anything else fails with status 29).
# Vonage's trial accepts a custom body, so CareBook's real
# details go out.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=
